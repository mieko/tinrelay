[Unit]
Description=TinRelay Codex bridge
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/tinrelay-codex-bridge run --ship SHIP --routing-file %h/.config/tinrelay/SHIP/codex-addresses.json --tinrelay %h/.local/bin/tinrelay --codex-home %h/.codex
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
