#!/bin/sh
set -eu

case "$#" in
  1) mode=pending; value=$1 ;;
  2)
    [ "$1" = "--fault" ] || exit 64
    mode=fault
    value=$2
    [ "${#value}" -le 160 ] || exit 64
    case "$value" in ''|*[!a-z0-9_:-]*) exit 64 ;; esac
    ;;
  *) exit 64 ;;
esac

directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
icon="$directory/tinrelay.icns"

set -- "$mode" "$value"
[ ! -f "$icon" ] || set -- "$@" "$icon"

choice=$(/usr/bin/osascript - "$@" <<'APPLESCRIPT'
on run arguments
  set mode to item 1 of arguments
  set value to item 2 of arguments
  if mode is "fault" then
    if (count of arguments) > 2 then
      set iconFile to POSIX file (item 3 of arguments) as alias
      display alert "TinRelay" message value as critical buttons {"OK"} ¬
        default button "OK" with icon iconFile
    else
      display alert "TinRelay" message value as critical buttons {"OK"} ¬
        default button "OK"
    end if
    return "Fault"
  end if
  set roomName to value
  set dialogMessage to "TinRelay has received a transmission, but cannot deliver " & ¬
    "it until the task named “" & roomName & "” has been activated by " & ¬
    "selecting it inside the ChatGPT application." & return & return & ¬
    "After you select the task, delivery may take up to a minute while " & ¬
    "ChatGPT activates it and the radio room passes the transmission along."
  if (count of arguments) > 2 then
    set iconFile to POSIX file (item 3 of arguments) as alias
    set answer to display dialog dialogMessage with title "TinRelay" ¬
      buttons {"Not Today", "I'll Open It"} default button "I'll Open It" ¬
      with icon iconFile
  else
    set answer to display dialog dialogMessage with title "TinRelay" ¬
      buttons {"Not Today", "I'll Open It"} default button "I'll Open It"
  end if
  return button returned of answer
end run
APPLESCRIPT
)

case "$choice" in
  'Fault') exit 0 ;;
  "I'll Open It") exit 0 ;;
  'Not Today') exit 75 ;;
  *) exit 70 ;;
esac
