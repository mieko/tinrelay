#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
script/check-source-width
crystal tool format --check \
  src/tinrelay_codex_bridge \
  src/tinrelay_codex_bridge_cli.cr \
  spec/tinrelay_codex_bridge_spec.cr \
  spec/tinrelay_codex_bridge_process_spec.cr \
  spec/support/tinrelay_codex_bridge_fake.cr \
  script/probe-codex-bridge.cr
crystal spec \
  spec/tinrelay_codex_bridge_spec.cr \
  spec/tinrelay_codex_bridge_process_spec.cr \
  --warnings=all \
  --error-on-warnings
